name = "burger-tin-orders"
main = "src/index.js"
compatibility_date = "2026-10-01"

[vars]
ALLOWED_ORIGIN = "https://asiles-lab.github.io,https://burger-tin-restia.burger-tin-orders.workers.dev,https://restia-admin.burger-tin-orders.workers.dev,https://burger-tin.restia.net.ar,https://admin.restia.net.ar"
PUBLIC_SITE_URL = "https://burger-tin.restia.net.ar/"
PUBLIC_API_URL = "https://burger-tin-orders.YOUR-SUBDOMAIN.workers.dev"
WHATSAPP_PHONE = "5491127798677"
PAYMENTS_MODE = "sandbox"
DEVICE_STORE_ID = "burger-tin"

[[d1_databases]]
binding = "DB"
database_name = "burger-tin-orders"
database_id = "REPLACE_AFTER_D1_CREATE"
migrations_dir = "migrations"

# Secrets (never put values in this file):
# wrangler secret put MP_ACCESS_TOKEN
# wrangler secret put MP_WEBHOOK_SECRET
# Bootstrap técnico inicial; no se usa para el ingreso cotidiano.
# wrangler secret put SUPERADMIN_TOKEN
# wrangler secret put DEVICE_TOKEN
# wrangler secret put SETTINGS_ENCRYPTION_KEY
