{
  "$schema": "../../restia/core/api/node_modules/wrangler/config-schema.json",
  "name": "restia-site-qa",
  "compatibility_date": "2026-10-25",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "../../.cloudflare-dist/qa/restia-site",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "qa.restia.net.ar", "custom_domain": true }
  ]
}
