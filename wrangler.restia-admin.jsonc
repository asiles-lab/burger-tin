{
  "$schema": "./backend/node_modules/wrangler/config-schema.json",
  "name": "restia-admin",
  "compatibility_date": "2026-10-25",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./.cloudflare-dist/restia-admin"
  },
  "routes": [
    { "pattern": "admin.restia.net.ar", "custom_domain": true }
  ]
}
